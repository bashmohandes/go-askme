{{define "feed.body"}}
<div div="container">
    {{if .Bag.User}}
        {{if ne .Bag.User.Email .Bag.ProfileUser.Email}}
            <div class="row">
                <div class="col-9">
                    <form class="form" action="/u/{{.Bag.ProfileUser.Email}}/questions" method="POST">
                        {{.Bag.csrfField}}
                        <div class="form-group">
                            <label for="question">Ask {{.Bag.ProfileUser.Name}} a question</label>
                            <textarea class="form-control form-control-lg" id="question" name="question" rows="2" required></textarea>
                        </div>
                        <p class="text-right">
                            <button class="btn btn-primary btn-lg" type="submit">Ask</button>
                        </p>
                    </form>
                </div>
            </div>
        {{end}}
    {{end}}
    <div class="row">
        <div class="col-9">            
            <div class="row">
                <div class="col">
                {{range .Bag.Feed.Items}}
                    <div class="media">
                        <img class="align-self-start mr-3" src="https://via.placeholder.com/64x64" alt="User Image">
                        <div class="media-body">
                            <h5 class="mt-0"><small><i><a href="/u/{{.QuestionAuthorEmail}}/questions">{{.QuestionAuthor}}</a></i></small>&nbsp;{{.Question}}</h5>
                            <small><i><a href="/u/{{.Email}}/questions">{{.User}}</a></i></small>&nbsp;{{.Answer}}
                        </div>
                    </div>
                    <br>
                {{end}}
                </div>
            </div>
        </div>
        <div class="col-3">
            <div class="card" style="width: 18rem;">
                <div class="card-body">
                    <h5 class="card-title">{{.Bag.ProfileUser.Name}}</h5>
                    <h6 class="card-subtitle mb-2 text-muted">{{.Bag.ProfileUser.Email}}</h6>
                </div>
            </div>
        </div>
    </div>
</div>
{{end}}
